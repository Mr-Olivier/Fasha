# Copy this file to ".env" (same folder) and fill in real values for local
# development. ".env" is git-ignored on purpose - never commit real secrets.
#
# These match the ${VAR_NAME:default} placeholders in
# src/main/resources/application.yml

# Must match docker-compose.yml (POSTGRES_USER / POSTGRES_PASSWORD / host port).
# DB_HOST only needs overriding if the backend ITSELF is also running in a
# container talking to another container (docker-compose's "backend"
# service sets DB_HOST=postgres for you already) - leave it unset here for
# running the backend directly on your machine.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=kazilink
DB_PASSWORD=kazilink

# Backs LoginAttemptService (login lockout) and RateLimiter (booking/review
# spam prevention) - both need Redis reachable to work at all, same as the
# backend needs Postgres reachable. docker-compose starts this by default
# (`docker compose up -d`, no profile needed) on its default port 6379, so
# these two rarely need overriding for local dev.
REDIS_HOST=localhost
REDIS_PORT=6379

# Any long random string. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string

# From https://app.brevo.com/settings/keys/api - used to email OTP codes
# (registration email verification, password reset). Leave unset and the
# backend just logs each code instead - no Brevo account needed for local
# dev. BREVO_SENDER_EMAIL must be a sender verified in that Brevo account
# (Settings > Senders & IP) or Brevo will reject the send.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@kazilink.rw
BREVO_SENDER_NAME=KaziLink Rwanda

# The Google Cloud "Web application" OAuth client ID - see NEXT_SESSION.md
# for how to create one. Leave unset and every other endpoint still works;
# only "Continue with Google" fails, with a clear error, until this is set.
GOOGLE_OAUTH_CLIENT_ID=

# Absolute path to a Firebase service account JSON key file - see
# NEXT_SESSION.md for how to create one. Leave unset and push notifications
# just get logged instead of actually sent - every other endpoint, and the
# in-app notification list itself, work fine either way.
FIREBASE_CREDENTIALS_PATH=

# From https://console.cloudinary.com/settings/api-keys (free tier - see
# NEXT_SESSION.md). Leave CLOUDINARY_CLOUD_NAME unset and avatars/category
# icons/provider photos just get saved to local disk instead - every other
# endpoint works fine either way.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
