# Copy this file to ".env" (same folder) and fill in real values for local
# development. ".env" is git-ignored on purpose - never commit real secrets.
#
# These match the ${VAR_NAME:default} placeholders in
# src/main/resources/application.yml

# Must match docker-compose.yml (POSTGRES_USER / POSTGRES_PASSWORD / host port)
DB_PORT=5433
DB_USERNAME=kazilink
DB_PASSWORD=kazilink

# Any long random string. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string
